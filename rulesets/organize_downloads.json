{
  "name": "Organize Downloads",
  "description": "Sort common file types into subfolders",
  "target_folder": "C:\\Users\\Colten\\Downloads",
  "rules": [
    { "pattern": "*.pdf", "action": "move", "destination": "Docs/PDFs" },
    { "pattern": "*.docx", "action": "move", "destination": "Docs/Word" },
    { "pattern": "*.png", "action": "move", "destination": "Media/Images" },
    { "pattern": "*.jpg", "action": "move", "destination": "Media/Images" },
    { "pattern": "*.zip", "action": "move", "destination": "Archives" },
    {
      "pattern": "*.log",
      "action": "delete",
      "condition": { "min_age_days": 30 }
    }
  ],
  "post_actions": [
    {
      "type": "create_index",
      "path": "Docs/index.md",
      "content": "## Docs index\n\nThis file was generated by file_organizer.\n"
    }
  ]
}
