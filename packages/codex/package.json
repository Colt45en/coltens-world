{
    "name": "@world-engine/codex",
    "version": "0.0.1",
    "description": "System Codex: production-grade schema with strict validation, cross-reference checks, deterministic canonicalization, and SHA256 snapshot hashing",
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        }
    },
    "dependencies": {
        "chokidar": "^3.6.0",
        "fast-glob": "^3.3.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "typescript": "^5.6.3"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.json",
        "cli:manifest": "node --enable-source-maps ./dist/src/cli.js"
    }
}
