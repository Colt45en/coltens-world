{
  "name": "@world-engine/engine",
  "version": "0.1.0",
  "description": "Deterministic ECS runtime and simulation core",
  "type": "module",
  "main": "./dist/engine/src/index.js",
  "types": "./dist/engine/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/engine/src/index.js",
      "types": "./dist/engine/src/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/engine/src/contracts/index.js",
      "types": "./dist/engine/src/contracts/index.d.ts"
    },
    "./contracts/ledger": {
      "import": "./dist/engine/src/contracts/ledger/index.js",
      "types": "./dist/engine/src/contracts/ledger/index.d.ts"
    },
    "./contracts/mesh": {
      "import": "./dist/engine/src/contracts/mesh/index.js",
      "types": "./dist/engine/src/contracts/mesh/index.d.ts"
    },
    "./contracts/artifacts": {
      "import": "./dist/engine/src/contracts/artifacts.js",
      "types": "./dist/engine/src/contracts/artifacts.d.ts"
    },
    "./contracts/json": {
      "import": "./dist/engine/src/contracts/json.js",
      "types": "./dist/engine/src/contracts/json.d.ts"
    },
    "./contracts/tool_call": {
      "import": "./dist/engine/src/contracts/tool_call.js",
      "types": "./dist/engine/src/contracts/tool_call.d.ts"
    },
    "./contracts/physics": {
      "import": "./dist/engine/src/contracts/physics/index.js",
      "types": "./dist/engine/src/contracts/physics/index.d.ts"
    },
    "./contracts/prefab": {
      "import": "./dist/engine/src/contracts/prefab/index.js",
      "types": "./dist/engine/src/contracts/prefab/index.d.ts"
    },
    "./contracts/world": {
      "import": "./dist/engine/src/contracts/world/index.js",
      "types": "./dist/engine/src/contracts/world/index.d.ts"
    },
    "./determinism": {
      "import": "./dist/engine/src/determinism/index.js",
      "types": "./dist/engine/src/determinism/index.d.ts"
    },
    "./mesh": {
      "import": "./dist/engine/src/mesh/index.js",
      "types": "./dist/engine/src/mesh/index.d.ts"
    },
    "./physics": {
      "import": "./dist/engine/src/physics/index.js",
      "types": "./dist/engine/src/physics/index.d.ts"
    },
    "./prefab": {
      "import": "./dist/engine/src/prefab/index.js",
      "types": "./dist/engine/src/prefab/index.d.ts"
    },
    "./world": {
      "import": "./dist/engine/src/world/index.js",
      "types": "./dist/engine/src/world/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@world-engine/protocol": "workspace:*",
    "@world-engine/bus": "workspace:*",
    "@world-engine/physics-contract": "workspace:*",
    "@world-engine/math": "workspace:*",
    "@world-engine/assets": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
