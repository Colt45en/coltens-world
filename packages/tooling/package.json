{
  "name": "@world-engine/tooling",
  "version": "0.1.0",
  "description": "Build helpers, process runners, and development utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "compile": "tsx src/compile.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "esbuild": "^0.25.10",
    "@world-engine/util": "workspace:*",
    "@world-engine/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
