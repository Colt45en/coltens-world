{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NucleusResponse",
  "type": "object",
  "required": ["version", "query_id", "timestamp_utc", "intent", "answer_text"],
  "properties": {
    "version": { "const": "nucleus.response.v1" },
    "query_id": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "intent": { "enum": ["retrieve", "tool", "memory", "clarify"] },
    "answer_text": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "confidence"],
        "properties": {
          "doc_id": { "type": "string" },
          "quote": { "type": "string" },
          "confidence": { "type": "number" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
