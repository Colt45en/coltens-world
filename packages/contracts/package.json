{
  "name": "@world-engine/contracts",
  "version": "0.1.0",
  "description": "Type-safe API contracts for Autonomy Loop (OpenAPI-generated)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.10"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "keywords": [
    "autonomy-loop",
    "contracts",
    "openapi",
    "generated-types"
  ]
}
