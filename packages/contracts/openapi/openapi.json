{
  "components": {
    "schemas": {
      "ClaimModel": {
        "description": "A graded meaning claim (not truth, but testable claim).",
        "properties": {
          "claim": {
            "title": "Claim",
            "type": "string"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "falsification_tests": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Falsification Tests",
            "type": "array"
          },
          "review_required": {
            "default": false,
            "title": "Review Required",
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "claim",
          "confidence"
        ],
        "title": "ClaimModel",
        "type": "object"
      },
      "DecisionRecordModel": {
        "description": "Decision snapshot with policy versions.",
        "properties": {
          "accepted_risks": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Accepted Risks",
            "type": "array"
          },
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "decision_id": {
            "title": "Decision Id",
            "type": "string"
          },
          "notes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "policy_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Policy Versions",
            "type": "object"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "red",
              "yellow",
              "green"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "decision_id",
          "batch_id",
          "created_at",
          "status"
        ],
        "title": "DecisionRecordModel",
        "type": "object"
      },
      "DriftItemModel": {
        "description": "Single drift detection result.",
        "properties": {
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "default": {},
            "title": "Details",
            "type": "object"
          },
          "drift_type": {
            "title": "Drift Type",
            "type": "string"
          }
        },
        "required": [
          "batch_id",
          "drift_type"
        ],
        "title": "DriftItemModel",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Standard error envelope.",
        "properties": {
          "code": {
            "default": "INTERNAL_ERROR",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidencePacketModel": {
        "description": "Raw input snapshot with tokenization, claims, objective.",
        "properties": {
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "claims": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/ClaimModel"
              },
              "type": "array"
            },
            "title": "Claims",
            "type": "object"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "objective": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Objective",
            "type": "object"
          },
          "raw": {
            "title": "Raw",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "source": {
            "additionalProperties": true,
            "title": "Source",
            "type": "object"
          },
          "tokens": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Tokens",
            "type": "object"
          }
        },
        "required": [
          "batch_id",
          "created_at",
          "source",
          "raw",
          "tokens",
          "claims",
          "objective"
        ],
        "title": "EvidencePacketModel",
        "type": "object"
      },
      "GateResultModel": {
        "description": "Individual gate validation result.",
        "properties": {
          "details": {
            "default": [],
            "items": {},
            "title": "Details",
            "type": "array"
          },
          "gate": {
            "title": "Gate",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "gate",
          "passed"
        ],
        "title": "GateResultModel",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestRequest": {
        "description": "Ingest raw text/code into autonomy loop.",
        "properties": {
          "kind": {
            "default": "mixed",
            "description": "Input kind",
            "enum": [
              "text",
              "code",
              "mixed"
            ],
            "title": "Kind",
            "type": "string"
          },
          "language_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Language (TypeScript, Python, etc.)",
            "title": "Language Hint"
          },
          "source_id": {
            "description": "Unique source identifier (e.g., file:src/math.ts)",
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "text": {
            "description": "Raw input text",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "text"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "LexiconEntryModel": {
        "description": "Language term with morphology, semantics, and trace.",
        "properties": {
          "language": {
            "title": "Language",
            "type": "string"
          },
          "lexicon_id": {
            "title": "Lexicon Id",
            "type": "string"
          },
          "morphology": {
            "additionalProperties": true,
            "title": "Morphology",
            "type": "object"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "semantics": {
            "additionalProperties": true,
            "title": "Semantics",
            "type": "object"
          },
          "term": {
            "title": "Term",
            "type": "string"
          },
          "trace": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Trace",
            "type": "object"
          }
        },
        "required": [
          "lexicon_id",
          "language",
          "term",
          "morphology",
          "semantics",
          "trace"
        ],
        "title": "LexiconEntryModel",
        "type": "object"
      },
      "ReplayBatchRequest": {
        "description": "Regression harness: replay batches and check for determinism drift.",
        "properties": {
          "days": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days"
          },
          "fail_on_unknown_tag": {
            "default": false,
            "title": "Fail On Unknown Tag",
            "type": "boolean"
          },
          "n": {
            "default": 25,
            "description": "Replay last N batches",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "N",
            "type": "integer"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO8601 timestamp lower bound",
            "title": "Since"
          }
        },
        "title": "ReplayBatchRequest",
        "type": "object"
      },
      "ReplayBatchResponse": {
        "description": "Regression report.",
        "properties": {
          "checked": {
            "title": "Checked",
            "type": "integer"
          },
          "drift": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/DriftItemModel"
            },
            "title": "Drift",
            "type": "array"
          },
          "drift_count": {
            "default": 0,
            "title": "Drift Count",
            "type": "integer"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "checked"
        ],
        "title": "ReplayBatchResponse",
        "type": "object"
      },
      "RunBatchRequest": {
        "description": "Run full batch: Detective → Alchemist → Analyst → Specialist → PM.",
        "properties": {
          "fail_on_unknown_tag": {
            "default": false,
            "description": "If set, unknown_tag forces red status",
            "title": "Fail On Unknown Tag",
            "type": "boolean"
          },
          "kind": {
            "default": "mixed",
            "enum": [
              "text",
              "code",
              "mixed"
            ],
            "title": "Kind",
            "type": "string"
          },
          "language_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language Hint"
          },
          "source_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "text"
        ],
        "title": "RunBatchRequest",
        "type": "object"
      },
      "RunBatchResponse": {
        "description": "Complete batch output (all 5 artifacts).",
        "properties": {
          "DecisionRecord": {
            "$ref": "#/components/schemas/DecisionRecordModel"
          },
          "EvidencePacket": {
            "$ref": "#/components/schemas/EvidencePacketModel"
          },
          "LexiconEntry": {
            "items": {
              "$ref": "#/components/schemas/LexiconEntryModel"
            },
            "title": "Lexiconentry",
            "type": "array"
          },
          "RuneDecoderRow": {
            "items": {
              "$ref": "#/components/schemas/RuneDecoderRowModel"
            },
            "title": "Runedecoderrow",
            "type": "array"
          },
          "ValidatedPlan": {
            "$ref": "#/components/schemas/ValidatedPlanModel"
          }
        },
        "required": [
          "EvidencePacket",
          "LexiconEntry",
          "RuneDecoderRow",
          "ValidatedPlan",
          "DecisionRecord"
        ],
        "title": "RunBatchResponse",
        "type": "object"
      },
      "RuneDecoderRowModel": {
        "description": "Code symbol with process tag classification.",
        "properties": {
          "code_language": {
            "title": "Code Language",
            "type": "string"
          },
          "meaning": {
            "additionalProperties": true,
            "title": "Meaning",
            "type": "object"
          },
          "methodology": {
            "items": {
              "type": "string"
            },
            "title": "Methodology",
            "type": "array"
          },
          "process_tag": {
            "title": "Process Tag",
            "type": "string"
          },
          "rune_id": {
            "title": "Rune Id",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "symbol_type": {
            "title": "Symbol Type",
            "type": "string"
          },
          "trace": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Trace",
            "type": "object"
          },
          "use": {
            "additionalProperties": true,
            "title": "Use",
            "type": "object"
          }
        },
        "required": [
          "rune_id",
          "code_language",
          "symbol",
          "symbol_type",
          "process_tag",
          "meaning",
          "use",
          "methodology",
          "trace"
        ],
        "title": "RuneDecoderRowModel",
        "type": "object"
      },
      "TaxonomyListRequest": {
        "description": "Query controlled vocabulary (process tags).",
        "properties": {
          "active_only": {
            "default": true,
            "title": "Active Only",
            "type": "boolean"
          }
        },
        "title": "TaxonomyListRequest",
        "type": "object"
      },
      "TaxonomyListResponse": {
        "description": "List of registered process tags.",
        "properties": {
          "tags": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tags",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "tags",
          "total"
        ],
        "title": "TaxonomyListResponse",
        "type": "object"
      },
      "ValidatedPlanModel": {
        "description": "Gate validation results with status.",
        "properties": {
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateResultModel"
            },
            "title": "Gates",
            "type": "array"
          },
          "hashes": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Hashes",
            "type": "object"
          },
          "review_requirements": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Review Requirements",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "red",
              "yellow",
              "green"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "batch_id",
          "gates",
          "status"
        ],
        "title": "ValidatedPlanModel",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Multi-agent knowledge artifact pipeline (TS↔PY contract boundary)",
    "title": "World Engine: Autonomy Loop API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/autonomy/v1/ingest": {
      "post": {
        "description": "Ingest: Extract EvidencePacket from raw text/code.\n\n**Tags:** Detective\n\n**Output:** EvidencePacket (batch_id, tokens, meaning claims, objective)",
        "operationId": "ingest_autonomy_v1_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ingest Autonomy V1 Ingest Post",
                  "type": "object"
                }
              }
            },
            "description": "EvidencePacket extracted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Ingest",
        "tags": [
          "Detective"
        ]
      }
    },
    "/autonomy/v1/replay-last": {
      "post": {
        "description": "Regression harness: Replay last N batches and check determinism.\n\n**Purpose:** Ensure that hash values don't drift over time (determinism invariant).\n\n**Advanced:**\n- `fail_on_unknown_tag=true` — Treat unknown_tag as taxonomy violation during replay\n- `since=ISO8601` — Limit replay to batches after timestamp\n- `days=N` — Alternative to `since` (last N days)\n\n**Exit code:** 0 if OK, 1 if drift detected (CI-friendly).",
        "operationId": "replay_last_autonomy_v1_replay_last_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayBatchResponse"
                }
              }
            },
            "description": "Regression analysis complete"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replay Last",
        "tags": [
          "Testing"
        ]
      }
    },
    "/autonomy/v1/run-batch": {
      "post": {
        "description": "Run full batch: Detective → Alchemist → Analyst → Specialist → PM.\n\n**Pipeline:**\n1. **Detective** — Extract EvidencePacket (tokenize, claim extraction)\n2. **Alchemist** — Build LexiconEntry[] + RuneDecoderRow[] (morphology, semantics)\n3. **Analyst** — Run gates → ValidatedPlan (schema, determinism, traceability, confidence, taxonomy)\n4. **Specialist** — Persist to SQLite, auto-populate review_queue\n5. **PM** — Generate DecisionRecord\n\n**Status computation (red/yellow/green):** Derived ONLY from gate results.\n\n**Advanced:**\n- `fail_on_unknown_tag=true` — Forces red if any rune has unknown_tag (tight governance week)",
        "operationId": "run_batch_autonomy_v1_run_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunBatchResponse"
                }
              }
            },
            "description": "Complete batch processed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Run Batch",
        "tags": [
          "Pipeline"
        ]
      }
    },
    "/autonomy/v1/taxonomy-list": {
      "post": {
        "description": "Query the controlled vocabulary (process tags).\n\n**Process tags** represent governance boundaries:\n- tokenize, parse, validate, compile, render, transport\n- storage, dedupe, governance, test, deploy, observe\n- unknown_tag (auto-classified, flagged for review)",
        "operationId": "taxonomy_list_autonomy_v1_taxonomy_list_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaxonomyListRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyListResponse"
                }
              }
            },
            "description": "Controlled vocabulary"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Taxonomy List",
        "tags": [
          "Governance"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:8000"
    },
    {
      "description": "Sidecar default",
      "url": "http://localhost:8001"
    }
  ]
}
