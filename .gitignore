# =========================
# Colten's World — .gitignore
# Production repo guardrails
# =========================

# ---- OS / Editor junk ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- Logs ----
*.log
logs/
**/*.log
*.ndjson
tmp/

# ---- Node / JS ----
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock

# pnpm store (if local)
.pnpm-store/
**/.pnpm-store/

# Turbo / build caches
.turbo/
**/.turbo/
.cache/
**/.cache/
turbo.log

# Vite / Next / web builds
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
storybook-static/
coverage/
**/coverage/

# TS build info
*.tsbuildinfo
**/*.tsbuildinfo

# Playwright outputs
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
.env
.env.*
.coverage
htmlcov/
**/htmlcov/
.tox/
*.egg-info/
dist/
build/

# ---- C/C++ / CMake / MSVC ----
CMakeFiles/
**/CMakeFiles/
CMakeCache.txt
**/CMakeCache.txt
cmake_install.cmake
**/cmake_install.cmake
Makefile
**/Makefile

# common out-of-source build dirs
cmake-build-*/
**/cmake-build-*/
**/build/**
*.obj
*.o
*.a
*.lib
*.dll
*.exe

# Visual Studio / MSVC
.vs/
**/.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/extensions.list.md
*.VC.db
*.opendb
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# ---- Databases / runtime artifacts ----
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
runtime/**/*.db
*.nexus.db
*.unified_nexus.db

# ---- Generated audit / pipeline artifacts ----
# These are volatile; only commit explicit summaries to docs/
.audit/**/cache.json
.audit/**/tool-events.ndjson
.audit/**/desktop-actions.ndjson
.audit/**/organizer_actions.ndjson
tooling/dist/
**/tooling/dist/
pipeline_results/
**/pipeline_results/

# ---- Large vendored tools ----
# These should live in vendor/ or be managed externally
oracleJdk-*/
**/oracleJdk-*/

# ---- IDE / Workspace ----
*.code-workspace
.idea/
.project
.classpath
.c9/
*.launch
.settings/

# ---- macOS ----
.AppleDouble
.LSOverride
._*

# ---- Linux ----
.directory

# ---- Windows ----
[Dd]esktop.ini
ehthumbs.db

# ---- Generated files (if you version codegen baselines) ----
# Uncomment if you want to ignore generated TS/Python from contracts
# packages/contracts-ts/dist/
# packages/contracts-py/dist/
