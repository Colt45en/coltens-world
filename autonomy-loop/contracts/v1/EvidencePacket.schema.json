{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autonomy-loop/schema/v1/EvidencePacket.schema.json",
    "title": "EvidencePacket",
    "description": "Raw input snapshot with tokenization, claims, objective; output of Detective role.",
    "type": "object",
    "required": [
        "schema_version",
        "batch_id",
        "created_at",
        "source",
        "raw",
        "tokens",
        "claims",
        "objective"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "batch_id": {
            "type": "string",
            "pattern": "^batch_[a-f0-9]{24}$"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "source": {
            "type": "object",
            "required": [
                "source_id",
                "kind",
                "language_hint"
            ],
            "properties": {
                "source_id": {
                    "type": "string"
                },
                "kind": {
                    "enum": [
                        "text",
                        "code",
                        "mixed"
                    ]
                },
                "language_hint": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "raw": {
            "type": "string"
        },
        "tokens": {
            "type": "object",
            "required": [
                "words",
                "code_symbols"
            ],
            "properties": {
                "words": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "code_symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "claims": {
            "type": "object",
            "required": [
                "meaning_claims"
            ],
            "properties": {
                "meaning_claims": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "claim_id",
                            "claim",
                            "confidence",
                            "review_required",
                            "falsification_tests"
                        ],
                        "properties": {
                            "claim_id": {
                                "type": "string"
                            },
                            "claim": {
                                "type": "string"
                            },
                            "confidence": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1.0
                            },
                            "review_required": {
                                "type": "boolean"
                            },
                            "falsification_tests": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "objective": {
            "type": "object",
            "required": [
                "metrics",
                "constraints",
                "acceptance_tests"
            ],
            "properties": {
                "metrics": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "acceptance_tests": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
