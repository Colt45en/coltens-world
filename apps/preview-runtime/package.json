{
  "name": "apps-preview-runtime",
  "private": true,
  "type": "module",
  "dependencies": {
    "@react-three/fiber": "^8.15.0",
    "@world-engine/engine": "workspace:*",
    "@world-engine/protocol": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "scripts": {
    "dev": "vite",
    "dev:inspect": "vite --inspect",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "preview": "vite preview",
    "analyze:build": "vite build --debug"
  }
}
