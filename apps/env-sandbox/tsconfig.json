{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "ignoreDeprecations": "5.0",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
