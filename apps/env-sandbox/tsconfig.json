{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "ignoreDeprecations": "5.0",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "ES2022",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
