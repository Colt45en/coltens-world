{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx", // Modern React transform
    "moduleResolution": "bundler", // Recommended for Vite
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "three"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.example.*", "src/**/example.*"]
}
