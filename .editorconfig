root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: keep trailing spaces (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# JS/TS
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# JSON / TS configs
[*.{json,jsonc}]
indent_size = 2

[*.{tsconfig,code-workspace}]
indent_size = 2

# NDJSON: stable + do not trim (sometimes spaces are meaningful in values)
[*.ndjson]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# TSV/CSV: never trim (tabs/spaces can matter)
[*.{tsv,csv}]
trim_trailing_whitespace = false
insert_final_newline = true

# Python
[*.py]
indent_size = 4
max_line_length = 100

# YAML
[*.{yml,yaml}]
indent_size = 2

# Shell
[*.{sh,bash}]
indent_size = 2

# Styles
[*.{css,scss,less}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Windows scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 2

# Makefiles must be tabs
[{Makefile,makefile,GNUmakefile}]
indent_style = tab

[.editorconfig]
indent_size = 2
