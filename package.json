{
  "name": "world-engine",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=9 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "three@^r128": "0.128.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "scripts": {
    "world": "node world.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "launch": "node scripts/launch-all.mjs",
    "launch:complete": "node scripts/launch-all.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:replay": "vitest run scripts/replay/replay.test.ts --globals",
    "test:avatar": "pnpm -C packages/avatar-compiler run test",
    "test:avatar:determinism": "pnpm -C packages/avatar-compiler run test:determinism",
    "build:avatar": "pnpm -C packages/avatar-compiler run build",
    "check": "pnpm -r --if-present run lint && pnpm -r --if-present run typecheck && pnpm check:dist-imports",
    "validate": "pnpm check && pnpm test",
    "contracts:sync": "node tools/codegen/sync-contracts.mjs",
    "dev:py": "pnpm -C apps/py-sidecar exec python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --reload",
    "dev:py:clean": "pwsh scripts/env/clean-env.ps1 python -m uvicorn",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build:deterministic": "pwsh scripts/env/clean-env.ps1 pnpm -r --if-present run build",
    "type-check": "pnpm run typecheck",
    "audit:imports": "node scripts/import-export-tracker.mjs --root . --write --dot",
    "audit:imports:watch": "node scripts/import-export-tracker.mjs --root . --write --dot --watch",
    "contracts:export": "python tooling/codegen/export_openapi.py",
    "contracts:ts": "openapi-typescript packages/contracts/openapi/openapi.json -o packages/contracts/ts/types.ts",
    "contracts:gen": "pnpm contracts:export && pnpm contracts:ts",
    "boundary:check": "node tools/boundary/check-boundaries.mjs",
    "boundary:check:json": "node tools/boundary/check-boundaries.mjs --json",
    "check:dist-imports": "node tools/boundary/check-no-dist-imports.mjs",
    "build:web": "pnpm -C apps/ide-web run build && pnpm -C apps/preview-runtime run build",
    "build:web:dev": "concurrently -n IDE,PREVIEW -c auto \"pnpm -C apps/ide-web run dev\" \"pnpm -C apps/preview-runtime run dev\"",
    "typecheck:web": "pnpm -C apps/ide-web run typecheck && pnpm -C apps/preview-runtime run typecheck",
    "build:cpp": "node tooling/cpp/build.js",
    "build:cpp:debug": "node tooling/cpp/build.js --debug",
    "build:compiler-a": "pnpm -C apps/web build",
    "build:compiler-b": "pnpm -C tooling/htmlts run build",
    "build:compilers": "pnpm build:compiler-a && pnpm build:compiler-b",
    "dev:compiler-a": "pnpm -C apps/web dev",
    "dev:compiler-b": "pnpm -C tooling/htmlts run watch",
    "test:compiler-a": "node tooling/test-compilers.mjs a",
    "test:compiler-b": "node tooling/test-compilers.mjs b",
    "test:compilers": "node tooling/test-compilers.mjs",
    "tooling:list": "node tooling/run.mjs --list",
    "tooling:run": "node tooling/run.mjs all",
    "tooling:determinism": "node tooling/test-compilers.mjs all",
    "tooling:determinism:verbose": "node tooling/test-compilers.mjs all --verbose",
    "tooling:baseline:all": "node tooling/run.mjs baseline all",
    "tooling:baseline": "node tooling/run.mjs baseline",
    "codegen": "pnpm contracts:gen && pnpm build:compilers",
    "lexicon:index": "pnpm tsx packages/brain/src/cli/lexicon-index.ts docs/lexicon/entries docs/lexicon/lexicon.index.json",
    "lexicon:validate-all": "pnpm tsx packages/brain/src/cli/validate-lexicon-all.ts docs/lexicon/entries",
    "memory:query": "pnpm tsx packages/brain/src/cli/memory-query.ts",
    "memory:stats": "pnpm tsx packages/brain/src/cli/memory-stats.ts",
    "memory:chain": "pnpm tsx packages/brain/src/cli/memory-chain.ts",
    "seed:world-engine": "tsx scripts/seed/seed-world-engine.ts --seed 1337",
    "prefab:room": "node tools/gen-room-prefab.mjs",
    "review:promote": "tsx packages/brain/src/cli/review-promote.ts",
    "spine:up": "node tools/spine.mjs up",
    "spine:audit": "node tools/spine.mjs audit",
    "spine:replay": "node tools/spine.mjs replay",
    "spine:doctor": "node tools/spine.mjs doctor",
    "prompts:validate": "pnpm tsx packages/engine/src/contracts/lexicon/validate-prompts.ts docs/prompts --fail-on-unknown-tag",
    "prompts:tags": "pnpm tsx packages/engine/src/contracts/lexicon/validate-prompts.ts --list-tags",
    "icons:gen": "node scripts/generate-post-icons.mjs --input posts.txt --out apps/ide-web/public/post-icons --size 96",
    "icons:check": "node scripts/generate-post-icons.mjs --input posts.txt --out apps/ide-web/public/post-icons --size 96 --check",
    "icons:watch": "nodemon --watch posts.txt --exec \"pnpm run icons:gen\"",
    "build:all": "pnpm lint && pnpm typecheck && pnpm build:cpp && pnpm build:web && pnpm build:compilers && pnpm -r --if-present run build",
    "test:e2e": "pnpm -C .. run test:e2e",
    "test:e2e:ui": "pnpm -C .. run test:e2e:ui",
    "test:e2e:headed": "pnpm -C .. run test:e2e:headed",
    "test:e2e:report": "pnpm -C .. run test:e2e:report",
    "env:check": "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force; &\"scripts/env/print-tooling-env.ps1\"",
    "env:info": "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force; &\"scripts/env/print-tooling-env.ps1\" && echo '' && echo 'See docs/ENVIRONMENT_HYGIENE.md for details'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "argparse": "^2.0.1",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "fast-glob": "^3.3.2",
    "globals": "^17.3.0",
    "husky": "^9.0.11",
    "openapi-typescript": "^6.7.5",
    "prettier": "^3.8.1",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^8.18.0",
    "@types/jszip": "^3.4.1",
    "express": "^4.18.2",
    "flag": "^5.0.1",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "three": "^0.182.0"
  }
}
